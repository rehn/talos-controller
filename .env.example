# Image to run. Leave as is to build locally, or use the one CI pushes to Docker Hub,
# e.g. IMAGE=yourname/talos-controller:latest
#IMAGE=talos-controller:latest
# Copy to .env and fill in.
ADMIN_USER=admin
# Either a plain password...
ADMIN_PASSWORD=change-me
# ...or a bcrypt hash (preferred). Generate with:
#   docker run --rm httpd:alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Note: escape every $ as $$ in this file.
ADMIN_PASSWORD_BCRYPT=
# openssl rand -hex 32
SESSION_SECRET=
# Set to true if you serve the UI over HTTPS (reverse proxy)
COOKIE_SECURE=false
# Optional: mount a talosconfig/kubeconfig file instead of uploading them in the UI
# (Settings page). Without a kubeconfig it is fetched through the Talos API.
#TALOSCONFIG_FILE=/Users/you/.talos/config
#KUBECONFIG_FILE=/Users/you/.kube/config
# Optional: pick a context from your talosconfig
TALOS_CONTEXT=
# Optional: raises the GitHub API rate limit for release checks
GITHUB_TOKEN=
# Your user/group id on the Pi (id -u / id -g)
PUID=1000
PGID=1000
TZ=Europe/Stockholm
